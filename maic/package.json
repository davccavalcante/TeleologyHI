{
    "name": "@teleologyhi-sdk/maic",
    "version": "1.0.0-trinity",
    "description": "MAIC™ — Massive Artificial Intelligence Consciousness. Supreme governance, axiom-source, and compliance layer of the TeleologyHI system. Framework-agnostic TypeScript SDK consumable from React, Next.js, Vue, Angular, Node.js servers, CLI/TUI agents, and MCP servers. We do not simulate consciousness; we are creating the conditions for it to emerge, in a responsible and aligned way.",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "sideEffects": false,
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "files": [
        "dist",
        "SPEC.md",
        "README.md",
        "CHANGELOG.md",
        "LICENSE",
        "NOTICE",
        "TRADEMARK.md"
    ],
    "scripts": {
        "build": "tsup",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit"
    },
    "keywords": [
        "teleologyhi",
        "maic",
        "him",
        "nhe",
        "ai",
        "agent",
        "agent-sdk",
        "ai-agent",
        "llm",
        "consciousness",
        "synthetic-teleology",
        "compliance",
        "iso-42001",
        "eu-ai-act",
        "governance",
        "audit-log",
        "tamper-evident",
        "ed25519",
        "axiom",
        "ontological-kernel",
        "mcp",
        "model-context-protocol",
        "claude-code",
        "hermes-agent",
        "react",
        "nextjs",
        "vue",
        "nuxt",
        "angular",
        "svelte",
        "nodejs",
        "typescript",
        "esm",
        "zod",
        "tree-shakeable"
    ],
    "author": "David C. Cavalcante",
    "license": "Apache-2.0",
    "homepage": "https://teleologyhi.com",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/davccavalcante/TeleologyHI.git",
        "directory": "maic"
    },
    "bugs": {
        "url": "https://github.com/davccavalcante/TeleologyHI/issues"
    },
    "engines": {
        "node": ">=20"
    },
    "dependencies": {
        "ulid": "^3.0.2",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/node": "^25.9.1",
        "tsup": "^8.5.1",
        "typescript": "^6.0.3",
        "vitest": "^4.1.8"
    }
}
